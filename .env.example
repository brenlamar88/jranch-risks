# Copy this file to ".env" and fill in the values from YOUR OWN Supabase project.
# These are read by the Vite frontend at build/run time.
#
# Find them in the Supabase dashboard for your NEW project:
#   Project Settings -> API
#     VITE_SUPABASE_URL              = Project URL
#     VITE_SUPABASE_PUBLISHABLE_KEY  = Project API keys -> "anon" / "publishable" key
#   Project Settings -> General
#     VITE_SUPABASE_PROJECT_ID       = Reference ID

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
